# Server
PORT=8010

# Database
MONGODB_URI=
DATABASE_URL=

# Auth / JWT
JWT_SECRET=change-this-development-secret
JWT_EXPIRES_IN_SECONDS=86400

# Redis & BullMQ
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=

# Mail (SMTP)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM="LibIO" <noreply@libio.com>

# Object storage (AWS S3 / Cloudflare R2)
STORAGE_ENDPOINT=
STORAGE_REGION=auto
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_BUCKET=cinema-assets
STORAGE_PUBLIC_URL=
STORAGE_FORCE_PATH_STYLE=false

# VNPay sandbox (get credentials from sandbox.vnpayment.vn)
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_HOST=https://sandbox.vnpayment.vn
VNPAY_RETURN_URL=http://localhost:8010/payments/vnpay/return
FRONTEND_URL=http://localhost:3000
