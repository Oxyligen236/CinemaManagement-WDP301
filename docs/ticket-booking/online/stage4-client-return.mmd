sequenceDiagram
    autonumber
    actor Customer as Customer (User)
    participant VNPay as VNPayGateway: External
    participant VNPayCtrl as VnpayReturnController: Boundary
    participant OrderSvc as OrderService: Control
    participant UI as CustomerClient: Boundary
    participant OrderCtrl as OrderController: Boundary

    %% ================= STAGE 4: CLIENT RETURN & ORDER SUMMARY =================
    Note over VNPay, UI: STAGE 4: Customer browser is redirected to Web/App & fetches order summary
    VNPay ->>+ VNPayCtrl: GET /payments/vnpay/return (vnp_ResponseCode=00, vnp_TxnRef)
    VNPayCtrl ->>+ OrderSvc: handleVnpayReturn(query)
    OrderSvc -->>- VNPayCtrl: { orderId, isSuccess: true, responseCode: '00' }
    VNPayCtrl -->>- UI: 302 Redirect /booking/payment-return?orderId=...&status=success
    UI ->>+ OrderCtrl: GET /orders/:orderId/summary
    OrderCtrl ->>+ OrderSvc: getBookingSummary(userId, orderId)
    OrderSvc -->>- OrderCtrl: BookingSummaryRes (status: PAID, ticketDetails, products)
    OrderCtrl -->>- UI: 200 OK (BookingSummaryRes)
    UI -->> Customer: Display booking confirmation screen & electronic QR tickets
