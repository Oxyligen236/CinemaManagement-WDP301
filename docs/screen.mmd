        Login -->|"Đăng nhập thành công (Staff)"| StaffOrders
        StaffOrders -->|Soát vé| StaffScan
        StaffOrders -->|Xem chi tiết đơn| StaffOrderDetail
        StaffScan -->|Quét mã| ScanResultBanner
    end

    %% Admin Management Flow
    subgraph AdminFlow [Admin Management]
        AdminDashboard["/admin/dashboard (Tổng quan Hệ thống)"]
        AdminUsers["/admin/users (Quản lý Người dùng)"]
        AdminPromotions["/promotions (Quản lý Khuyến mãi)"]
        AdminOrders["/orders (Quản lý toàn bộ đơn hàng)"]
        AdminOrderDetail["[Modal] Chi tiết đơn hàng"]

        Login -->|"Đăng nhập thành công (Admin)"| AdminDashboard
        AdminDashboard -->|Quản lý Người dùng| AdminUsers
        AdminDashboard -->|Quản lý Khuyến mãi| AdminPromotions
        AdminDashboard -->|Quản lý Đơn hàng| AdminOrders
        AdminOrders -->|Xem chi tiết| AdminOrderDetail
    end

