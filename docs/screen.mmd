flowchart TD
    %% Public Flow
    Home["/ (Trang chủ)"]
    Login["/login (Đăng nhập)"]
    Register["/register (Đăng ký)"]
    VerifyEmail["/verify-email (Xác thực Email)"]

    Home -->|Click Đăng nhập| Login
    Home -->|Click Đăng ký| Register
    Login -->|Click Đăng ký| Register
    Login -->|Đăng nhập thành công (User)| Home
    Register -->|Đăng ký thành công| VerifyEmail
    Register -->|Click Đăng nhập| Login
    VerifyEmail -->|Xác thực thành công| Login

    %% Admin Portal
    AdminPromotions["/promotions (Admin - Quản lý Khuyến mãi)"]
    AdminMovies["/movies (Admin - Quản lý Phim)"]

    Login -->|Đăng nhập thành công (Admin)| AdminPromotions
    Login -->|Đăng nhập thành công (Admin)| AdminMovies
    AdminPromotions <-->|Chuyển tab Sidebar| AdminMovies

    %% Admin Films
    AdminFilms["/admin/films (Admin - Quản lý Phim)"]
    CreateFilmModal["Modal Tạo Phim (Chọn poster upload, nhập link trailer)"]
    DeactivateFilmDialog["Dialog Xác nhận Vô hiệu hóa"]

    Login -->|Đăng nhập thành công (Admin)| AdminFilms
    AdminFilms -->|Click Tạo phim mới| CreateFilmModal
    CreateFilmModal -->|Lưu thành công / Hủy| AdminFilms
    AdminFilms -->|Click Vô hiệu hóa| DeactivateFilmDialog
    DeactivateFilmDialog -->|Xác nhận / Hủy| AdminFilms

    %% Admin Price Multipliers
    AdminPriceMultipliers["/admin/price-multipliers (Admin - Cấu hình danh sách hệ số giá vé)"]
    DeletePriceValueDialog["Dialog xác nhận xóa giá trị hệ số"]

    Login -->|Đăng nhập thành công (Admin)| AdminPriceMultipliers
    AdminPriceMultipliers -->|Thêm / Sửa inline thành công, làm mới tại chỗ| AdminPriceMultipliers
    AdminPriceMultipliers -->|Click Xóa giá trị| DeletePriceValueDialog
    DeletePriceValueDialog -->|Xác nhận / Hủy| AdminPriceMultipliers
    AdminPriceMultipliers -->|Chưa đăng nhập / 401| Login

    %% Manager Showtimes
    ManagerShowtimes["/manager/showtimes (Manager - Quản lý Suất chiếu)"]
    ShowtimeFormModal["Modal Tạo/Sửa suất chiếu (Phim, Ngày, Giờ, Phòng, Hệ số giá)"]
    ShowtimeConflictDialog["Popup lỗi MSG03 - Phòng trùng lịch"]
    DeleteShowtimeDialog["Dialog Xác nhận Xóa suất chiếu"]

    Login -->|Đăng nhập thành công (Manager)| ManagerShowtimes
    ManagerShowtimes -->|Click Tạo suất chiếu / Sửa| ShowtimeFormModal
    ShowtimeFormModal -->|Lưu thành công MSG02 / Hủy| ManagerShowtimes
    ShowtimeFormModal -->|Phòng trùng lịch| ShowtimeConflictDialog
    ShowtimeConflictDialog -->|Chọn phòng/khung giờ khác| ShowtimeFormModal
    ManagerShowtimes -->|Click Xóa| DeleteShowtimeDialog
    DeleteShowtimeDialog -->|Xác nhận / Hủy| ManagerShowtimes
    ManagerShowtimes -->|Chưa đăng nhập / 401| Login
